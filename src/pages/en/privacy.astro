---
export const prerender = true;

import BaseLayout from '../../layouts/BaseLayout.astro';
import Header from '../../components/Header.astro';
import PageHero from '../../components/PageHero.astro';
import Footer from '../../components/Footer.astro';
---

<BaseLayout
  title="Privacy Policy — ФОП РУЖАНСЬКИЙ"
  description="Privacy Policy of ФОП РУЖАНСЬКИЙ. Terms of collection and use of personal data."
  lang="en"
>
  <Header lang="en" />
  <main>
    <PageHero
      title="Privacy Policy"
      subtitle="Terms of collection, storage and use of personal data."
      backLabel="Home"
      backHref="/en/"
    />

    <section class="privacy-content">
      <div class="container">
        <div class="prose">

          <h2>1. General Provisions</h2>
          <p>This Privacy Policy governs the processing of personal data provided by users of the ФОП РУЖАНСЬКИЙ website (hereinafter "we" or the "Operator"). By using the contact form on the website, you agree to the terms of this Policy.</p>

          <h2>2. Data We Collect</h2>
          <p>When filling out the contact form, we collect the following personal data:</p>
          <ul>
            <li>Name (or first name for addressing);</li>
            <li>Phone number for callback.</li>
          </ul>
          <p>We do not collect payment information, email addresses, or any other data unless you voluntarily provide it in your message.</p>

          <h2>3. Purpose of Data Processing</h2>
          <p>The collected personal data is used exclusively for the following purposes:</p>
          <ul>
            <li>contacting you to clarify the details of your inquiry;</li>
            <li>providing consultations on fire safety and engineering systems;</li>
            <li>preparing commercial proposals upon your request.</li>
          </ul>

          <h2>4. Sharing Data with Third Parties</h2>
          <p>We do not sell, transfer or disclose your personal data to third parties, except as required by applicable law of Ukraine.</p>
          <p>Technically, your request is sent to our administrative channel via a secure API interface. Only authorized representatives of ФОП РУЖАНСЬКИЙ have access to the data.</p>

          <h2>5. Retention Period</h2>
          <p>Personal data is stored for the time necessary to process your request and maintain business relations, but no more than <strong>12 months</strong> from the date of receipt. After this period, the data is deleted.</p>

          <h2>6. Data Security</h2>
          <p>We take technical and organizational measures to protect your personal data from unauthorized access, loss or disclosure. Data is transmitted over a secure connection (HTTPS).</p>

          <h2>7. Your Rights</h2>
          <p>You have the right to:</p>
          <ul>
            <li>know the sources of collection and the purpose of using your data;</li>
            <li>access your personal data;</li>
            <li>request correction or deletion of your data;</li>
            <li>withdraw consent to data processing at any time.</li>
          </ul>

          <h2>8. Cookies</h2>
          <p>The website is static and does not use cookies for tracking or analytics. Technical cookies may be used solely to ensure the correct operation of the website.</p>

          <h2>9. Contact Information</h2>
          <p>For all questions regarding the processing of personal data, please contact:</p>
          <ul>
            <li>Email: <a href="mailto:info@ruzhanskyi.com">info@ruzhanskyi.com</a></li>
            <li>Phone: +38 (0XX) XXX-XX-XX</li>
          </ul>

          <h2>10. Changes to the Policy</h2>
          <p>We reserve the right to make changes to this Privacy Policy. The current version is always available on this page. Last updated: 22.05.2026.</p>

        </div>
      </div>
    </section>
  </main>
  <Footer lang="en" />
</BaseLayout>

<style>
  .privacy-content {
    background-color: var(--color-surface);
    padding: 72px 0 96px;
  }

  .prose {
    max-width: 760px;
  }

  .prose h2 {
    font-weight: 500;
    font-size: 18px;
    color: var(--color-text);
    margin-top: 40px;
    margin-bottom: 12px;
    line-height: 1.3;
  }

  .prose h2:first-child {
    margin-top: 0;
  }

  .prose p {
    font-weight: 400;
    font-size: 15px;
    color: var(--color-text-muted);
    line-height: 1.75;
    margin-bottom: 12px;
  }

  .prose ul {
    margin: 0 0 12px 0;
    padding-left: 20px;
  }

  .prose ul li {
    font-weight: 400;
    font-size: 15px;
    color: var(--color-text-muted);
    line-height: 1.75;
    margin-bottom: 6px;
    list-style: disc;
  }

  .prose a {
    color: var(--color-accent);
    text-decoration: underline;
    text-underline-offset: 2px;
  }

  .prose strong {
    font-weight: 500;
    color: var(--color-text);
  }

  @media (max-width: 768px) {
    .privacy-content {
      padding: 48px 0 64px;
    }
  }
</style>
