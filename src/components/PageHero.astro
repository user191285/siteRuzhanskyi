---
export interface Props {
  title: string;
  subtitle?: string;
  backLabel?: string;
  backHref?: string;
}

const { title, subtitle, backLabel, backHref } = Astro.props;
---

<section class="page-hero">
  <div class="container">
    {backHref && (
      <a href={backHref} class="back-link">← {backLabel}</a>
    )}
    <h1>{title}</h1>
    {subtitle && <p class="subtitle">{subtitle}</p>}
  </div>
</section>

<style>
  .page-hero {
    background-color: var(--color-bg);
    padding: 56px 0 52px;
    border-bottom: 1px solid var(--color-input);
  }

  .back-link {
    display: inline-block;
    font-weight: 400;
    font-size: 13px;
    color: var(--color-text-muted);
    margin-bottom: 20px;
    transition: color 0.2s;
    letter-spacing: 0.2px;
  }

  .back-link:hover {
    color: var(--color-accent);
  }

  h1 {
    font-weight: 900;
    font-size: 32px;
    line-height: 1.2;
    color: var(--color-text);
    letter-spacing: -0.5px;
    margin-bottom: 0;
  }

  .subtitle {
    font-weight: 400;
    font-size: 15px;
    color: var(--color-text-muted);
    line-height: 1.7;
    margin-top: 16px;
    max-width: 640px;
  }

  @media (max-width: 768px) {
    .page-hero {
      padding: 40px 0 36px;
    }
    h1 {
      font-size: 24px;
    }
  }
</style>
