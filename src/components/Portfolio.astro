---
export interface Props {
  lang?: 'uk' | 'en';
}

const { lang = 'uk' } = Astro.props;

const content = {
  uk: {
    heading: 'Реалізовані проекти пожежної безпеки',
    statusLabel: 'Захищено',
    projects: [
      {
        type: 'ТРЦ',
        title: 'ТРК The Mall',
        description: "Комплексна система пожежної сигналізації та автоматичного пожежогасіння. Площа об'єкту — 5 700 м².",
        location: 'Вінниця',
      },
      {
        type: 'Бізнес-центр',
        title: "Прем'єр-Тауер",
        description: 'Проектування та монтаж систем пожежного захисту для висотного будинку. Площа — 44 000 м².',
        location: 'Вінниця',
      },
      {
        type: 'Торговий центр',
        title: 'АВРОРА',
        description: "Повний комплекс інженерних рішень пожежної безпеки. Площа об'єкту — 20 000 м².",
        location: 'Вінниця',
      },
    ],
  },
  en: {
    heading: 'Completed Fire Safety Projects',
    statusLabel: 'Protected',
    projects: [
      {
        type: 'Shopping Mall',
        title: 'The Mall TRK',
        description: 'Comprehensive fire alarm and automatic fire suppression system. Facility area — 5,700 m².',
        location: 'Vinnytsia',
      },
      {
        type: 'Business Center',
        title: 'Premier Tower',
        description: 'Design and installation of fire protection systems for a high-rise building. Area — 44,000 m².',
        location: 'Vinnytsia',
      },
      {
        type: 'Shopping Center',
        title: 'AVRORA',
        description: 'Full suite of fire safety engineering solutions. Facility area — 20,000 m².',
        location: 'Vinnytsia',
      },
    ],
  },
}[lang];
---

<section id="portfolio" class="portfolio">
  <div class="container">
    <h2 class="section-heading">{content.heading}</h2>
    <div class="portfolio-grid">
      {content.projects.map((project) => (
        <div class="portfolio-card">
          <div class="card-image">
            <span class="image-label">{project.type}</span>
          </div>
          <div class="card-body">
            <span class="object-type">{project.type}</span>
            <h3 class="card-title">{project.title}</h3>
            <p class="card-description">{project.description}</p>
            <div class="card-footer">
              <span class="location">{project.location}</span>
              <div class="status-badge">
                <span class="status-dot"></span>
                <span class="status-text">{content.statusLabel}</span>
              </div>
            </div>
          </div>
        </div>
      ))}
    </div>
  </div>
</section>

<style>
  .portfolio {
    background-color: var(--color-surface);
    padding: 80px 0;
  }

  .section-heading {
    font-weight: 500;
    font-size: 28px;
    color: var(--color-text);
    margin-bottom: 48px;
    line-height: 1.3;
  }

  .portfolio-grid {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 24px;
  }

  .portfolio-card {
    border: 1px solid var(--color-input);
    background-color: var(--color-surface);
    border-radius: 2px;
    overflow: hidden;
    transition: box-shadow 0.25s;
  }

  .portfolio-card:hover {
    box-shadow: 0 4px 28px rgba(0, 0, 0, 0.08);
  }

  .card-image {
    background-color: var(--color-input);
    /* 40% of card is the image zone (using aspect-ratio) */
    aspect-ratio: 16 / 9;
    display: flex;
    align-items: center;
    justify-content: center;
  }

  .image-label {
    font-weight: 300;
    font-size: 10px;
    color: var(--color-muted-label);
    letter-spacing: 1.5px;
    text-transform: uppercase;
  }

  .card-body {
    padding: 24px;
    display: flex;
    flex-direction: column;
    gap: 10px;
  }

  .object-type {
    font-weight: 300;
    font-size: 10px;
    color: var(--color-muted-label);
    letter-spacing: 1.5px;
    text-transform: uppercase;
  }

  .card-title {
    font-weight: 500;
    font-size: 16px;
    color: var(--color-text);
    line-height: 1.3;
  }

  .card-description {
    font-weight: 400;
    font-size: 13px;
    color: var(--color-text-muted);
    line-height: 1.65;
  }

  .card-footer {
    display: flex;
    align-items: center;
    justify-content: space-between;
    padding-top: 12px;
    border-top: 1px solid var(--color-input);
    margin-top: 4px;
  }

  .location {
    font-weight: 300;
    font-size: 12px;
    color: var(--color-muted-label);
  }

  .status-badge {
    display: flex;
    align-items: center;
    gap: 5px;
  }

  .status-dot {
    width: 7px;
    height: 7px;
    border-radius: 50%;
    background-color: var(--color-success);
    display: block;
    flex-shrink: 0;
  }

  .status-text {
    font-size: 12px;
    font-weight: 500;
    color: var(--color-success);
  }

  @media (max-width: 1024px) {
    .portfolio-grid {
      grid-template-columns: repeat(2, 1fr);
    }
  }

  @media (max-width: 640px) {
    .portfolio-grid {
      grid-template-columns: 1fr;
    }
    .section-heading {
      font-size: 24px;
      margin-bottom: 32px;
    }
  }
</style>
